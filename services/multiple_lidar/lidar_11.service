[Unit]
Description=Multilidar starting service device 11
After=lidar_10.service
PartOf=multiple_lidar_barre_2.target

[Service]
Type=simple
RemainAfterExit=no
ExecStartPre=/bin/sleep 20
ExecStart=/usr/bin/multiple_lidar 2025042800140410
Restart=always
ExecStop=pkill 'multiple_lidar 2025042800140410'

[Install]
WantedBy=multi-user.target
