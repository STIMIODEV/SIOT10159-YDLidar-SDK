[Unit]
Description=Multilidar starting service device on bar 1
Wants=lidar_1.service lidar_2.service lidar_3.service lidar_4.service lidar_5.service lidar_6.service

[Service]
Type=simple
RemainAfterExit=yes
Restart=no
ExecStart=echo "starting Lidar acquisition"

[Install]
WantedBy=multi-user.target
